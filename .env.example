# Component: module: foundryvtt
# ==============================================================================
# Note: This file provides module defaults. Hub base.env variables are merged
#       automatically by Spoke. Site-specific overrides go in modules.yml.
# ==============================================================================

#### IMAGE

FOUNDRYVTT_IMAGE=felddy/foundryvtt:14.364.0

#### NETWORK

FOUNDRYVTT_IP=192.168.35.25
FOUNDRYVTT_HOST=foundry.${DOMAIN}

#### DATA

# Path to FoundryVTT persistent data (worlds, systems, modules)
FOUNDRYVTT_DATA_DIR=${APPDATA_DIR}/foundryvtt/data
